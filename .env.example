# =========================================================
# SoulCut - Environment Configuration Template
# =========================================================

# Application
VITE_APP_TITLE=SoulCut
PORT=3000
NODE_ENV=development

# Minds API (Persistent Creative Mind Memory)
MINDS_API_KEY=your_minds_api_key_or_jwt_here
MINDS_BASE_URL=https://api.useminds.com
MINDS_APP_ID=your_minds_mind_id_here
MINDS_MIND_ID=your_minds_mind_id_here

# AI / LLM Engine (Groq, OpenAI, or Forge)
BUILT_IN_FORGE_API_URL=https://api.groq.com/openai
BUILT_IN_FORGE_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# Database (Optional - SoulCut includes automatic in-memory fallback for zero-barrier local dev)
# For persistent production storage, provide a MySQL connection URI:
# DATABASE_URL=mysql://user:password@localhost:3306/soulcut

# Optional S3 Storage for transcripts & exports (defaults to local memory/temp store if omitted)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=
